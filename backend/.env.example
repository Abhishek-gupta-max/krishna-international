# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:4200
# Number of reverse-proxy hops in front of the API (0 = none, 1 = Nginx, 2 = Vercel + host load balancer)
TRUST_PROXY=0

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=krishna_app
DB_PASSWORD=change-me
DB_NAME=krishna_international
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Initial super admin (used only by `npm run seed` when no admin exists yet)
SEED_ADMIN_NAME=Aviral Pandey
SEED_ADMIN_EMAIL=krishnainternationalgkp@gmail.com
# Minimum 10 characters. Change it after first login.
SEED_ADMIN_PASSWORD=

# ---------- Uploads ----------
MAX_CV_SIZE_MB=5
MAX_IMAGE_SIZE_MB=6

# ---------- Rate limits ----------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
FORM_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=10

LOG_LEVEL=info
