{
  "name": "krishna-international-api",
  "version": "1.0.0",
  "description": "REST API for Krishna International Overseas Services",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node database/migrate.js",
    "migrate:status": "node database/migrate.js --status",
    "seed": "node database/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "sharp": "^0.33.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
